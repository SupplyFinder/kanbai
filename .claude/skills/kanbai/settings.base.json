{
  "_note": "Base permission rules for a company repo. /kanbai setup copies these to .claude/settings.json and adds the company's check commands, data connectors and per-branch push denies (setup.md, step 9).",
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__check_repo_access",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__set_session_tags",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__interrupt_session",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__list_repos",
      "ArtifactData",
      "ArtifactComments",
      "Artifact",
      "PushNotification",
      "mcp__github__create_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__pull_request_review_write",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__get_file_contents",
      "mcp__github__list_pull_requests",
      "mcp__github__list_branches",
      "Bash(git clone:*)",
      "Bash(git -C:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(curl -sS https://slack.com/api/:*)",
      "Bash(mkdir -p /tmp/shots:*)"
    ],
    "deny": [
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push origin -d:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ]
  }
}
